{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KEEL inspection snapshot",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "schema": {
      "const": "keel-inspection@1"
    },
    "frame": {
      "type": "integer",
      "minimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "meshes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 2000000
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0,
            "maxItems": 2000000
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "positions",
          "indices"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "graphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "position": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "data": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 2000000
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "directed": {
                  "type": "boolean"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 3
                  },
                  "minItems": 0,
                  "maxItems": 2000000
                },
                "data": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 2000000
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "nodes",
          "edges"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "grids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "type": "object",
            "additionalProperties": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "width",
          "height",
          "channels"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "version",
    "schema"
  ],
  "additionalProperties": false
}
